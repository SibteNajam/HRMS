// Cadre — HR management schema
// Design rules (see docs/03-database-schema.md):
//   1. Nothing is stored that can be derived.
//   2. Except snapshots — a payslip freezes its numbers permanently.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL no longer lives here. Migrations read it from
// prisma.config.ts; the runtime client gets it through a driver adapter.
datasource db {
  provider = "mysql"
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum Role {
  EMPLOYEE
  HR
  ADMIN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum RecommendationVerdict {
  APPROVE
  REVIEW
  REJECT
}

enum RecommendationConfidence {
  HIGH
  MEDIUM
  LOW
}

enum PayrollRunStatus {
  DRAFT
  FINALISED
}

enum DueType {
  LOAN
  ADVANCE
  EQUIPMENT
  OTHER
}

enum DueStatus {
  ACTIVE
  CLEARED
  WAIVED
}

enum NotificationType {
  LEAVE
  PAYROLL
  DUES
  ATTENDANCE
  SYSTEM
}

enum EmailStatus {
  SENT
  FAILED
}

enum AiMessageRole {
  USER
  ASSISTANT
}

// ─── Core ───────────────────────────────────────────────────────────────

model Department {
  id        Int           @id @default(autoincrement())
  name      String        @unique @db.VarChar(100)
  employees Employee[]
  teams     ProjectTeam[]

  @@map("departments")
}

model Employee {
  id               Int              @id @default(autoincrement())
  employeeCode     String           @unique @map("employee_code") @db.VarChar(20)
  firstName        String           @map("first_name") @db.VarChar(50)
  lastName         String           @map("last_name") @db.VarChar(50)
  email            String           @unique @db.VarChar(120)
  phone            String?          @db.VarChar(20)
  departmentId     Int              @map("department_id")
  designation      String           @db.VarChar(80)
  joiningDate      DateTime         @map("joining_date") @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  baseSalary       Decimal          @map("base_salary") @db.Decimal(12, 2)
  /// Fixed monthly allowance (transport, housing). Copied onto each payslip
  /// so a later change never alters a payslip already issued.
  allowances       Decimal          @default(0) @db.Decimal(12, 2)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  department    Department     @relation(fields: [departmentId], references: [id])
  user          User?
  attendance    Attendance[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  payslips      Payslip[]
  dues          Due[]
  projectTeams  ProjectTeamMember[]

  @@index([departmentId])
  @@index([employmentStatus])
  @@map("employees")
}

model User {
  id           Int       @id @default(autoincrement())
  employeeId   Int?      @unique @map("employee_id")
  email        String    @unique @db.VarChar(120)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  employee        Employee?        @relation(fields: [employeeId], references: [id])
  reviewedLeaves  LeaveRequest[]   @relation("LeaveReviewer")
  processedRuns   PayrollRun[]     @relation("PayrollProcessor")
  notifications   Notification[]
  aiConversations AiConversation[]

  @@map("users")
}

/// Pre-assigned roles. An ADMIN adds an email here BEFORE the person signs
/// up; registration then grants exactly this role. Anyone not listed gets
/// EMPLOYEE — the least privileged option, so the system fails closed.
///
/// This is the authorization source. The email PREFIX (emp./hr./ad.) is a
/// naming convention for humans and is never read by the code: the address is
/// typed by the person signing up, so it cannot be trusted to grant privilege.
model RoleAssignment {
  id         Int       @id @default(autoincrement())
  email      String    @unique @db.VarChar(120)
  role       Role
  note       String?   @db.VarChar(255)
  /// Set the first time an account claims it. Kept, not deleted, so there is
  /// a record of who was granted what and when.
  claimedAt  DateTime? @map("claimed_at")
  createdBy  Int?      @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("role_assignments")
}

// ─── Attendance ─────────────────────────────────────────────────────────

model Attendance {
  id         Int              @id @default(autoincrement())
  employeeId Int              @map("employee_id")
  date       DateTime         @db.Date
  checkIn    DateTime?        @map("check_in")
  checkOut   DateTime?        @map("check_out")
  status     AttendanceStatus
  createdAt  DateTime         @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

/// Company holidays. A date here is not a working day: it is excluded from
/// the attendance percentage denominator and from leave working-day counts,
/// and the nightly absentee job skips it.
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("holidays")
}

// ─── Leave ──────────────────────────────────────────────────────────────

model LeaveType {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  annualQuota Int     @map("annual_quota")
  isPaid      Boolean @default(true) @map("is_paid")

  requests LeaveRequest[]
  balances LeaveBalance[]

  @@map("leave_types")
}

model LeaveBalance {
  id          Int     @id @default(autoincrement())
  employeeId  Int     @map("employee_id")
  leaveTypeId Int     @map("leave_type_id")
  year        Int     @db.SmallInt
  allocated   Decimal @db.Decimal(4, 1)
  used        Decimal @default(0) @db.Decimal(4, 1)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id          Int                @id @default(autoincrement())
  employeeId  Int                @map("employee_id")
  leaveTypeId Int                @map("leave_type_id")
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime           @map("end_date") @db.Date
  days        Decimal            @db.Decimal(4, 1)
  reason      String             @db.Text
  status      LeaveRequestStatus @default(PENDING)
  reviewedBy  Int?               @map("reviewed_by")
  reviewedAt  DateTime?          @map("reviewed_at")
  reviewNote  String?            @map("review_note") @db.VarChar(255)
  /// Decided by the rules engine with no human in the loop. HR sees these
  /// in a separate list and can still reverse one.
  autoApproved     Boolean       @default(false) @map("auto_approved")
  /// Why it went through automatically, in the words HR reads.
  autoDecisionNote String?       @map("auto_decision_note") @db.VarChar(500)
  createdAt   DateTime           @default(now()) @map("created_at")

  employee       Employee             @relation(fields: [employeeId], references: [id])
  leaveType      LeaveType            @relation(fields: [leaveTypeId], references: [id])
  reviewer       User?                @relation("LeaveReviewer", fields: [reviewedBy], references: [id])
  recommendation LeaveRecommendation?

  @@index([status])
  @@index([employeeId, status])
  @@map("leave_requests")
}

/// The assistant's advice on one pending request.
///
/// Stored rather than held in the browser so leaving the screen and coming
/// back does not mean paying for the same analysis twice — the free tier is
/// capped on tokens per minute, and the advice does not change unless the
/// facts behind it do.
///
/// `factsHash` is what makes that safe. It fingerprints the decision context
/// the advice was given on; when a colleague's leave is approved or an
/// absence is recorded, the hash stops matching and the advice is shown as
/// stale instead of quietly standing on figures that have moved.
model LeaveRecommendation {
  id             Int                      @id @default(autoincrement())
  leaveRequestId Int                      @unique @map("leave_request_id")
  verdict        RecommendationVerdict
  confidence     RecommendationConfidence
  reason         String                   @db.VarChar(500)
  /// The facts cited, so a reviewer can check the reasoning against the record.
  basis          Json?
  /// Set when the rules engine overrode what the model proposed.
  adjusted       String?                  @db.VarChar(255)
  /// Advice from a different model is not the same advice.
  model          String                   @db.VarChar(80)
  factsHash      String                   @map("facts_hash") @db.Char(40)
  generatedBy    Int                      @map("generated_by")
  generatedAt    DateTime                 @default(now()) @map("generated_at")

  request LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@map("leave_recommendations")
}

// ─── Payroll ────────────────────────────────────────────────────────────

model PayrollRun {
  id          Int              @id @default(autoincrement())
  month       Int              @db.TinyInt
  year        Int              @db.SmallInt
  status      PayrollRunStatus @default(DRAFT)
  processedBy Int?             @map("processed_by")
  processedAt DateTime?        @map("processed_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  processor User?     @relation("PayrollProcessor", fields: [processedBy], references: [id])
  payslips  Payslip[]

  @@unique([month, year])
  @@map("payroll_runs")
}

/// Snapshot table — every figure is frozen at issue time, deliberately.
model Payslip {
  id                   Int     @id @default(autoincrement())
  payrollRunId         Int     @map("payroll_run_id")
  employeeId           Int     @map("employee_id")
  baseSalary           Decimal @map("base_salary") @db.Decimal(12, 2)
  allowances           Decimal @default(0) @db.Decimal(12, 2)
  overtimeAmount       Decimal @default(0) @map("overtime_amount") @db.Decimal(12, 2)
  unpaidLeaveDeduction Decimal @default(0) @map("unpaid_leave_deduction") @db.Decimal(12, 2)
  otherDeductions      Decimal @default(0) @map("other_deductions") @db.Decimal(12, 2)
  duesDeduction        Decimal @default(0) @map("dues_deduction") @db.Decimal(12, 2)
  bonus                Decimal @default(0) @db.Decimal(12, 2)
  netSalary            Decimal @map("net_salary") @db.Decimal(12, 2)

  payrollRun  PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee    Employee     @relation(fields: [employeeId], references: [id])
  duePayments DuePayment[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

// ─── Dues ───────────────────────────────────────────────────────────────

model Due {
  id                 Int       @id @default(autoincrement())
  employeeId         Int       @map("employee_id")
  type               DueType
  description        String    @db.VarChar(255)
  principalAmount    Decimal   @map("principal_amount") @db.Decimal(12, 2)
  monthlyInstallment Decimal   @map("monthly_installment") @db.Decimal(12, 2)
  status             DueStatus @default(ACTIVE)
  issuedOn           DateTime  @map("issued_on") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at")

  employee Employee     @relation(fields: [employeeId], references: [id])
  payments DuePayment[]

  @@index([employeeId, status])
  @@map("dues")
}

/// Paid and remaining are derived from SUM(amount). No stored balance.
model DuePayment {
  id        Int      @id @default(autoincrement())
  dueId     Int      @map("due_id")
  payslipId Int?     @map("payslip_id")
  amount    Decimal  @db.Decimal(12, 2)
  paidOn    DateTime @map("paid_on") @db.Date

  due     Due      @relation(fields: [dueId], references: [id])
  payslip Payslip? @relation(fields: [payslipId], references: [id])

  @@index([dueId])
  @@map("due_payments")
}

// ─── Communication ──────────────────────────────────────────────────────

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(120)
  body      String           @db.VarChar(500)
  link      String?          @db.VarChar(200)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model EmailLog {
  id      Int         @id @default(autoincrement())
  toEmail String      @map("to_email") @db.VarChar(120)
  subject String      @db.VarChar(200)
  body    String      @db.Text
  status  EmailStatus
  error   String?     @db.VarChar(500)
  sentAt  DateTime    @default(now()) @map("sent_at")

  @@map("email_log")
}

// ─── AI ─────────────────────────────────────────────────────────────────

model AiConversation {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  user     User        @relation(fields: [userId], references: [id])
  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             Int           @id @default(autoincrement())
  conversationId Int           @map("conversation_id")
  role           AiMessageRole
  content        String        @db.Text
  toolsUsed      Json?         @map("tools_used")
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ─── Audit ──────────────────────────────────────────────────────────────

/// No FK on actorUserId — the log must outlive the user it refers to.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId Int      @map("actor_user_id")
  action      String   @db.VarChar(60)
  entity      String   @db.VarChar(40)
  entityId    Int      @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}


// ─── Projects and staffing ──────────────────────────────────────────────

/// A piece of work with teams on it.
///
/// Leave stopped being only about the person asking once this existed: a
/// request that is fine for the individual can still be the one that leaves
/// a project without enough people to run.
model Project {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(120)
  code        String        @unique @db.VarChar(20)
  description String?       @db.VarChar(500)
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @map("start_date") @db.Date
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  teams ProjectTeam[]

  @@map("projects")
}

/// A team working on one project — "Tech", "Marketing", "Finance".
///
/// The minimum is held here rather than on the project because a marketing
/// team of three and an engineering team of eight do not need the same
/// cover, and HR sets each one separately.
model ProjectTeam {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  name         String   @db.VarChar(60)
  /// Which department the team draws from. Context for HR, not a constraint.
  departmentId Int?     @map("department_id")
  /// How many members must still be available on any day covered by a
  /// leave request. Approving below this is what the staffing rule stops.
  minimumStaff Int      @default(1) @map("minimum_staff")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department Department?         @relation(fields: [departmentId], references: [id])
  members    ProjectTeamMember[]

  @@unique([projectId, name])
  @@index([departmentId])
  @@map("project_teams")
}

/// Who is on a team.
///
/// `roleOnTeam` is separate from the employee's designation on purpose: the
/// same person can be a Backend Engineer on one project and a Tech Lead on
/// another, and cover has to be judged by what they do on THIS project.
model ProjectTeamMember {
  id            Int      @id @default(autoincrement())
  projectTeamId Int      @map("project_team_id")
  employeeId    Int      @map("employee_id")
  roleOnTeam    String?  @map("role_on_team") @db.VarChar(80)
  assignedAt    DateTime @default(now()) @map("assigned_at")

  team     ProjectTeam @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectTeamId, employeeId])
  @@index([employeeId])
  @@map("project_team_members")
}
