# ── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3001

# ── Database ───────────────────────────────────────────────
DATABASE_URL="mysql://root:changeme@localhost:3306/cadre"

# ── Auth ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_SECONDS=86400
COOKIE_NAME=cadre_session
BCRYPT_ROUNDS=12

# ── Registration policy ────────────────────────────────────
# open | domain | invite_only
SIGNUP_MODE=domain
ALLOWED_EMAIL_DOMAINS=cadrehrms.com

# ── AI ─────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_MAX_TOKENS=1024
AI_MAX_TURNS=8
AI_HISTORY_WINDOW=10

# ── Email ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AI-HRMS <hr.aihrms@gmail.com>"
MAIL_DRY_RUN=true

# ── HR policy ──────────────────────────────────────────────
STANDARD_WORK_HOURS=8
WORK_DAY_START=09:00
LATE_THRESHOLD_MINUTES=15
OVERTIME_RATE_MULTIPLIER=1.5
WEEKEND_DAYS=0,6

# Approve leave with no human when every rule passes: balance, attendance,
# and no project team taken below its minimum staffing. HR still sees each
# one and can reverse it. Anything a rule flags is held for review instead.
LEAVE_AUTO_APPROVAL=true

# ── Recruitment ────────────────────────────────────────────
# Where uploaded CVs are written.
COMPANY_NAME=AI-HRMS
COMPANY_TIMEZONE=Asia/Karachi
UPLOAD_DIR=uploads

# The mailbox candidates send CVs to. Leave IMAP_USER empty and email
# intake stays off — HR can still upload CVs by hand and everything else
# works. For Gmail: enable IMAP in settings and use an App Password, the
# same one you use for SMTP.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
